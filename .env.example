# ─────────────────────────────────────────────────────────────────
# IceLaser Landing — Variáveis de Ambiente (.env.example)
# Copie pra .env.local e preencha com valores reais.
# NÃO COMMITAR arquivos .env*  (protegido no .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── Meta Ads / CAPI ──────────────────────────────────────────────
# Token do System User (long-lived, nunca expira)
META_ACCESS_TOKEN=

# App secret do Meta App (usado pra validar webhooks do WhatsApp)
META_APP_SECRET=

# IDs da conta (valores de produção IceLaser como fallback no código)
META_PIXEL_ID=2774496306216737
META_WABA_ID=920807647253970
META_PAGE_ID=111790301665816
META_AD_ACCOUNT_ID=act_790663154114264
META_APP_ID=940244045396548

# IDs da unidade João Pessoa/Bancários (não reutilizar valores Recife)
META_PIXEL_ID_JPA=1386967056530127
META_PAGE_ID_JPA=1077786125420191
META_AD_ACCOUNT_ID_JPA=act_26473489532272684

# ── WhatsApp Cloud API ───────────────────────────────────────────
WA_PHONE_NUMBER_ID=1140709345781659
WA_PHONE_NUMBER_ID_JPA=1104617299399194
WA_VERIFY_TOKEN=   # string qualquer que você define ao configurar webhook na Meta

# ── Dataset scoped CAPI tokens ───────────────────────────────────
CAPI_DATASET_TOKEN=
CAPI_DATASET_TOKEN_JP=

# ── Kommo João Pessoa ────────────────────────────────────────────
# Kommo native CAPI dispara Lead/Purchase. Este projeto só complementa stages.
KOMMO_CAPI_DATASET_ID=1694874711857319
KOMMO_TOKEN_JP=
KOMMO_WEBHOOK_SECRET=

# ── WAM ──────────────────────────────────────────────────────────
# V5 Pixel-only: WAM fica fail-closed por padrão.
WAM_WRITE_MODE=disabled

# ── Chatwoot ─────────────────────────────────────────────────────
# Secret compartilhado com Chatwoot pra validar webhooks HMAC
# Configurar em: Chatwoot → Settings → Integrations → Webhook → Secret
CHATWOOT_WEBHOOK_SECRET=
# Quando CHATWOOT_WEBHOOK_ENFORCE=1, rejeita webhooks sem signature válida.
# Deixar vazio/0 enquanto valida que Chatwoot está enviando signature correta.
CHATWOOT_WEBHOOK_ENFORCE=0

# ── Email Notificações (Gmail App Password) ──────────────────────
EMAIL_FROM=espacoicelaserrecife2@gmail.com
EMAIL_PASS=
EMAIL_TO=espacoicelaserrecife2@gmail.com,thiagosml@gmail.com

# ── Vercel (gerado automaticamente pelo Vercel CLI) ──────────────
BLOB_READ_WRITE_TOKEN=
EDGE_CONFIG=
CRON_SECRET=

# ── Analytics / Feature Flags ────────────────────────────────────
FLAGS_SECRET=
LOG_DRAIN_SECRET=
VERCEL_WEBHOOK_SECRET=
VERCEL_API_TOKEN=

# ── Defaults de negócio ──────────────────────────────────────────
DEFAULT_PURCHASE_VALUE=497
DEFAULT_PREDICTED_LTV=980

# ── Rate Limiting (Edge Middleware) ──────────────────────────────
RATE_LIMIT_MAX=120           # requests/minuto por IP
RATE_LIMIT_ENFORCE=0         # 0=warn-only, 1=rejeita 429 quando excede

# ── Node ─────────────────────────────────────────────────────────
NODE_OPTIONS=
CONVERSION_API_KEY=
